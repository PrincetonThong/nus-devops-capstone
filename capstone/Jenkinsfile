pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        DOCKER_IMAGE = 'tjysats/nus-devops-capstone-finsecurepay'
        AWS_REGION = 'ap-southeast-1'
        AWS_EKS_CLUSTER_NAME = 'finsecurepay-cluster'
        AWS_NAMESPACE = 'finsecurepay'
    }
    
    // https://www.jenkins.io/doc/book/pipeline/syntax/#declarative-steps
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // in task1 we did ./mvnw.cmd clean
        stage('Build') {
            steps {
                dir('capstone') {
                    bat '.\\mvnw.cmd clean compile'
                }
            }
        }

        // in task1 we did ./mvnw.cmd test
        stage('Unit Tests') {
            steps {
                dir('capstone') {
                    bat '.\\mvnw.cmd test'
                }
            }
        }

        // in task2 we did docker build -t tjysats/nus-devops-capstone-finsecurepay:v1.0.0 .
        stage('Build Docker Image') {
            steps {
                dir('capstone') {
                    bat 'docker build -t %DOCKER_IMAGE%:v1.0.%BUILD_NUMBER% .'
                }
            }
        }

        // in task2 we did docker push tjysats/nus-devops-capstone-finsecurepay:v1.0.0
        stage('Push to Dockerhub') {
            steps {
                dir('capstone') {
                    // https://www.jenkins.io/doc/book/pipeline/docker/
                    script {
                        docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-tjysats') {
                            def image = docker.image("${env.DOCKER_IMAGE}:v1.0.${env.BUILD_NUMBER}")
                            image.push()
                        }
                    }
                }
            }
        }


    }
}