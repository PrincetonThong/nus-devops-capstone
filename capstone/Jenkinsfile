pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        DOCKER_IMAGE = 'tjysats/nus-devops-capstone-finsecurepay'
        AWS_REGION = 'ap-southeast-1'
        AWS_EKS_CLUSTER_NAME = 'finsecurepay-cluster'
        AWS_NAMESPACE = 'finsecurepay'
    }
    
    // https://www.jenkins.io/doc/book/pipeline/syntax/#declarative-steps
    // in initial build, got this message "Batch scripts can only be run on Windows nodes", so need to use linux
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // in task1 we did ./mvnw.cmd clean
        stage('Build') {
            steps {
                dir('capstone') {
                    sh 'sh ./mvnw -B -ntp clean compile'
                }
            }
        }

        // in task1 we did ./mvnw.cmd test
        stage('Unit Tests') {
            steps {
                dir('capstone') {
                    sh 'sh ./mvnw -B -ntp test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('capstone') {
                    sh 'sh ./mvnw -B -ntp package -DskipTests'
                }
            }
        }

        // in task2 we did docker build -t tjysats/nus-devops-capstone-finsecurepay:v1.0.0 .
        stage('Build Docker Image') {
            steps {
                dir('capstone') {
                    // sh 'docker build -t ${DOCKER_IMAGE}:v1.0.${BUILD_NUMBER} .'
                    
                    // to be able to sync on this laptop, we need to create zscaler credential in jenkins, and then in dockerfile re-enable the zscaler part
                    withCredentials([file(credentialsId: 'zscaler-root-ca', variable: 'ZSCALER_CA')]) {
                        sh 'DOCKER_BUILDKIT=1 docker build --secret id=zscaler_root_ca,src="$ZSCALER_CA" -t "${DOCKER_IMAGE}:v1.0.${BUILD_NUMBER}" .'
                    }
                }
            }
        }

        // in task2 we did docker push tjysats/nus-devops-capstone-finsecurepay:v1.0.0
        stage('Push to Dockerhub') {
            steps {
                dir('capstone') {
                    // https://www.jenkins.io/doc/book/pipeline/docker/
                    script {
                        docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-tjysats') {
                            def image = docker.image("${env.DOCKER_IMAGE}:v1.0.${env.BUILD_NUMBER}")
                            image.push()
                        }
                    }
                }
            }
        }


    }
}
