pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        DOCKER_IMAGE = 'tjysats/nus-devops-capstone-finsecurepay'
        AWS_REGION = 'ap-southeast-1'
        AWS_EKS_CLUSTER_NAME = 'finsecurepay-cluster'
        AWS_NAMESPACE = 'finsecurepay'
        TRIVY_PATH = '/var/jenkins_home/bin/trivy'
    }
    
    // https://www.jenkins.io/doc/book/pipeline/syntax/#declarative-steps
    // in initial build, got this message "Batch scripts can only be run on Windows nodes", so need to use linux
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // in task1 we did ./mvnw.cmd clean
        stage('Build') {
            steps {
                dir('capstone') {
                    sh 'sh ./mvnw -B -ntp clean compile'
                }
            }
        }

        // in task1 we did ./mvnw.cmd test
        stage('Unit Tests') {
            steps {
                dir('capstone') {
                    sh 'sh ./mvnw -B -ntp test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('capstone') {
                    sh 'sh ./mvnw -B -ntp package -DskipTests'
                }
            }
        }

        // task 5 for static code quality analysis
        stage('Code Quality') {
            steps {
                dir('capstone') {
                    sh 'sh ./mvnw -B -ntp com.github.spotbugs:spotbugs-maven-plugin:4.10.5.0:check'
                }
            }
        }

        // security scan for app proj dependencies
        stage('Dependency Scan') {
            steps {
                dir('capstone') {
                    sh '"$TRIVY_PATH" --version'
                    
                    sh '"$TRIVY_PATH" fs --timeout 15m --scanners vuln --no-progress --format json --output target/trivy-dependency-report.json .'

                    sh '"$TRIVY_PATH" convert --scanners vuln --severity HIGH,CRITICAL --exit-code 1 --format table target/trivy-dependency-report.json'
                }
            }
        }

        // in task2 we did docker build -t tjysats/nus-devops-capstone-finsecurepay:v1.0.0 .
        stage('Build Docker Image') {
            steps {
                dir('capstone') {
                    // sh 'docker build -t ${DOCKER_IMAGE}:v1.0.${BUILD_NUMBER} .'
                    
                    // to be able to sync on this laptop, we need to create zscaler credential in jenkins, and then in dockerfile re-enable the zscaler part
                    withCredentials([file(credentialsId: 'zscaler-root-ca', variable: 'ZSCALER_CA')]) {
                        sh 'DOCKER_BUILDKIT=1 docker build --secret id=zscaler_root_ca,src="$ZSCALER_CA" -t "${DOCKER_IMAGE}:v1.0.${BUILD_NUMBER}" .'
                    }
                }
            }
        }

        // security scan of built docker image
        stage('Container Image Scan') {
            steps {
                dir('capstone') {
                    sh '"$TRIVY_PATH" image --timeout 15m --scanners vuln --no-progress --format json --output target/trivy-image-report.json "${DOCKER_IMAGE}:v1.0.${BUILD_NUMBER}"'

                    sh '"$TRIVY_PATH" convert --scanners vuln --severity HIGH,CRITICAL --exit-code 1 --format table target/trivy-image-report.json'
                }
            }
        }

        // in task2 we did docker push tjysats/nus-devops-capstone-finsecurepay:v1.0.0
        stage('Push to Dockerhub') {
            steps {
                dir('capstone') {
                    // https://www.jenkins.io/doc/book/pipeline/docker/
                    script {
                        retry(3) {
                            docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-tjysats') {
                                def image = docker.image("${env.DOCKER_IMAGE}:v1.0.${env.BUILD_NUMBER}")
                                image.push()
                            }
                        }
                    }
                }
            }
        }

        // in task3 we did aws eks update-kubeconfig --region ap-southeast-1 --name finsecurepay-cluster
        stage('Verify AWS EKS') {
            steps {
                dir('capstone') {
                    sh 'aws --version'
                    sh 'eksctl version'
                    sh 'kubectl version --client'
                    sh 'aws sts get-caller-identity > /dev/null'

                    script {
                        def check_if_cluster_exists = sh(
                            script: 'aws eks describe-cluster --region ${AWS_REGION} --name ${AWS_EKS_CLUSTER_NAME} > /dev/null',
                            returnStatus: true
                        )

                        if (check_if_cluster_exists == 0) {
                            echo "EKS cluster ${env.AWS_EKS_CLUSTER_NAME} exists"
                        } else {
                            sh 'eksctl create cluster --name ${AWS_EKS_CLUSTER_NAME} --region ${AWS_REGION} --nodegroup-name finsecurepay-nodes --nodes 2 --node-type t3.small --managed'
                        }
                    }

                    sh 'aws eks update-kubeconfig --region ${AWS_REGION} --name ${AWS_EKS_CLUSTER_NAME}'
                    sh 'kubectl get nodes'
                }
            }
        }

        // in task3 we did kubectl apply -f k8s/finsecurepay.yaml and deploy image created
        stage('Deploy to EKS') {
            steps {
                dir('capstone') {
                    script {
                        def check_if_deployment_exists = sh(
                            script: 'kubectl get deployment finsecurepay -n ${AWS_NAMESPACE} > /dev/null 2>&1',
                            returnStatus: true
                        )

                        if (check_if_deployment_exists != 0) {
                            echo 'Deployment does not exist. Applying Task 3 Kubernetes YAML...'
                            sh 'kubectl apply -f k8s/finsecurepay.yaml'
                        }
                    }

                    sh 'kubectl set image deployment/finsecurepay finsecurepay-container=${DOCKER_IMAGE}:v1.0.${BUILD_NUMBER} -n ${AWS_NAMESPACE}'
                }
            }
        }

        stage('Verify Rollout') {
            steps {
                dir('capstone') {
                    sh 'kubectl rollout status deployment/finsecurepay -n ${AWS_NAMESPACE} --timeout=300s'
                    sh 'kubectl get all -n ${AWS_NAMESPACE}'
                    sh 'kubectl get deployment finsecurepay -n ${AWS_NAMESPACE} -o jsonpath="{.spec.template.spec.containers[0].image}"'
                }
            }

            // https://www.jenkins.io/doc/book/pipeline/syntax/#post
            // if new pods didnt become ready, auto roll back to previous revision
            post {
                failure {
                    echo 'Rollout failed. Rolling back to previous revision...'
                    sh 'kubectl rollout undo deployment/finsecurepay -n ${AWS_NAMESPACE}'
                    sh 'kubectl rollout status deployment/finsecurepay -n ${AWS_NAMESPACE} --timeout=300s'
                    sh 'kubectl get deployment finsecurepay -n ${AWS_NAMESPACE} -o jsonpath="{.spec.template.spec.containers[0].image}"'
                }
            }
        }
    }

    // save archive reports
    post {
        always {
            junit testResults: 'capstone/target/surefire-reports/*.xml', allowEmptyResults: true

            archiveArtifacts artifacts: 'capstone/target/spotbugsXml.xml,capstone/target/trivy-*.json', allowEmptyArchive: true

            // task 6: email build result through Resend's HTTPS API because SMTP is unavailable in this environment
            // recipient is a credential too, to keep personal email address out of public repo
            withEnv(["BUILD_RESULT=${currentBuild.currentResult}"]) {
                withCredentials([
                    string(credentialsId: 'resend-api-key', variable: 'RESEND_API_KEY'),
                    string(credentialsId: 'notify-email', variable: 'NOTIFY_EMAIL')
                ]) {
                    sh '''
                        curl -sS --fail-with-body -H "Authorization: Bearer $RESEND_API_KEY" -H "Content-Type: application/json" --data '{"from":"onboarding@resend.dev","to":"'"$NOTIFY_EMAIL"'","subject":"'"$JOB_NAME"' #'"$BUILD_NUMBER"': '"$BUILD_RESULT"'","text":"Build '"$BUILD_RESULT"'. Console output: '"$BUILD_URL"'console"}' https://api.resend.com/emails
                    '''
                }
            }
        }
    }
}
